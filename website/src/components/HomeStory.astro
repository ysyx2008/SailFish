---
import { useTranslations, localePath, type Lang } from '../i18n/utils';
import { defaultLanguage } from '../i18n/translations';

interface Props {
  lang?: Lang;
}

const { lang = defaultLanguage } = Astro.props;
const t = useTranslations(lang);
const sections = [t.story.task, t.story.companion, t.story.handsOn, t.story.memory, t.story.legion];
---

<section class="home-story" id="how-it-works" aria-label={t.nav.features}>
  {sections.map((section, index) => {
    const imageSrc = lang === 'zh' ? section.image : section.imageEn;
    const reversed = index % 2 === 1;
    const copyReveal = reversed ? 'reveal-right' : 'reveal-left';
    const indexLabel = String(index + 1).padStart(2, '0');
    return (
      <div class:list={['story-block', { reversed }]} id={section.id}>
        <div class="container story-inner">
          <div class:list={['story-copy', 'fade-in', copyReveal]}>
            <p class="story-index">{indexLabel}</p>
            <h2 class="story-title">{section.title}</h2>
            <p class="story-body">{section.body}</p>
            <ul class="story-points reveal-stagger" style="--stagger-base: 140ms">
              {section.points.map((point, i) => (
                <li style={`--i: ${i}`}>{point}</li>
              ))}
            </ul>
            {'href' in section && section.href && (
              <a class="story-link" href={localePath(lang, section.href)}>
                {section.linkLabel} <span aria-hidden="true">→</span>
              </a>
            )}
          </div>
          <div class="story-media fade-in reveal-scale fade-in-delay-1">
            <img src={imageSrc} alt={section.imageAlt} loading="lazy" />
          </div>
        </div>
      </div>
    );
  })}
</section>

<style>
  .home-story {
    background: var(--color-bg-primary);
  }

  .story-block {
    padding: 96px 0;
    border-top: 1px solid color-mix(in srgb, var(--color-border) 70%, transparent);
  }

  .story-block:first-child {
    border-top: none;
    padding-top: 48px;
  }

  .story-inner {
    display: grid;
    grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.08fr);
    gap: 72px;
    align-items: center;
  }

  .story-block.reversed .story-inner {
    grid-template-columns: minmax(0, 1.08fr) minmax(0, 0.92fr);
  }

  .story-block.reversed .story-copy {
    order: 2;
  }

  .story-block.reversed .story-media {
    order: 1;
  }

  .story-index {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    color: var(--color-accent-primary);
    margin-bottom: 14px;
  }

  .story-title {
    font-size: clamp(1.65rem, 2.8vw, 2.125rem);
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1.2;
    margin-bottom: 14px;
    color: var(--color-text-primary);
  }

  .story-body {
    font-size: 1.0625rem;
    line-height: 1.75;
    color: var(--color-text-secondary);
    margin-bottom: 28px;
    max-width: 32em;
  }

  .story-points {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 0;
    margin: 0;
  }

  .story-points li {
    position: relative;
    padding-left: 16px;
    font-size: 0.9375rem;
    color: var(--color-text-primary);
    font-weight: 450;
    letter-spacing: -0.01em;
  }

  .story-points li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--color-accent-primary);
    opacity: 0.85;
  }

  .story-link {
    display: inline-block;
    margin-top: 24px;
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--color-accent-primary);
    text-decoration: none;
    transition: opacity var(--duration-micro) var(--ease-out-soft);
  }

  .story-link:hover {
    opacity: 0.72;
  }

  .story-media {
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--color-bg-secondary);
    box-shadow:
      0 0 0 1px color-mix(in srgb, var(--color-border) 75%, transparent),
      0 18px 48px rgba(28, 25, 23, 0.06);
    transition:
      opacity var(--duration-reveal) var(--ease-out-soft),
      transform var(--duration-reveal) var(--ease-out-soft);
  }

  [data-theme="dark"] .story-media {
    box-shadow:
      0 0 0 1px color-mix(in srgb, var(--color-border) 90%, transparent),
      0 20px 52px rgba(0, 0, 0, 0.4);
  }

  .story-media img {
    display: block;
    width: 100%;
    height: auto;
  }

  @media (max-width: 900px) {
    .story-inner,
    .story-block.reversed .story-inner {
      grid-template-columns: 1fr;
      gap: 32px;
    }

    .story-block.reversed .story-copy,
    .story-block.reversed .story-media {
      order: unset;
    }

    .story-block {
      padding: 64px 0;
    }

    .story-block:first-child {
      padding-top: 24px;
    }
  }
</style>
