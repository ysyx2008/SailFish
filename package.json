    "@xterm/addon-search": "^0.15.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^5.5.0",
    "adm-zip": "^0.6.1",
    "apache-arrow": "^18.1.0",
    "archiver": "^8.0.0",
    "cron-parser": "^5.5.0",
    "cronstrue": "^3.14.0",
    "dingtalk-stream": "^2.1.4",
    "docx": "^9.5.1",
    "echarts": "^6.0.0",
    "electron-log": "^5.4.3",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.8.9",
    "exceljs": "^4.4.0",
    "https-proxy-agent": "^7.0.4",
    "iconv-lite": "^0.7.0",
    "imapflow": "^1.4.2",
    "jieba-wasm": "^2.4.0",
    "jsdom": "^29.1.1",
    "keytar": "^7.9.0",
    "lucide-vue-next": "^0.562.0",
    "mailparser": "^3.9.14",
    "mammoth": "^1.11.0",
    "marked": "^18.0.5",
    "marked-cjk-friendly": "^0.1.1",
    "mermaid": "^11.16.1",
    "node-html-parser": "^7.1.0",
    "node-pty": "^1.0.0",
    "nodemailer": "^9.1.1",
    "pdf-parse": "^2.4.5",
    "pinia": "^2.1.7",
    "playwright-core": "^1.57.0",
    "pptxgenjs": "^4.0.1",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.4",
    "sherpa-onnx-node": "^1.12.23",
    "socks-proxy-agent": "^8.0.2",
    "ssh2": "^1.15.0",
    "ssh2-sftp-client": "^12.0.1",
    "strip-ansi": "^7.1.2",
    "telegraf": "^4.16.3",
    "tsdav": "^2.1.6",
    "uuid": "^9.0.1",
    "virtua": "^0.50.0",
    "vue": "^3.4.21",
    "vue-i18n": "^9.14.5",
    "word-extractor": "^1.0.4",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.2",
    "@rushstack/eslint-patch": "^1.7.2",
    "@types/adm-zip": "^0.5.7",
    "@types/archiver": "^8.0.0",
    "@types/jsdom": "^28.0.1",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^20.11.24",
    "@types/nodemailer": "^8.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/ssh2": "^1.15.0",
    "@types/ssh2-sftp-client": "^9.0.6",
    "@types/uuid": "^9.0.8",
    "@types/yauzl": "^3.4.0",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vitest/coverage-v8": "^4.1.7",
    "@vitest/ui": "^4.1.7",
    "@vue/eslint-config-prettier": "^9.0.0",
    "@vue/eslint-config-typescript": "^12.0.0",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "electron": "^39.8.10",
    "electron-builder": "^26.15.3",
    "eslint": "^8.57.0",
    "eslint-plugin-vue": "^9.22.0",
    "patch-package": "^8.0.1",
    "prettier": "^3.2.5",
    "ts-morph": "^27.0.2",
    "tsx": "^4.21.0",
    "typescript": "^5.4.2",
    "vite": "^6.4.2",
    "vite-plugin-electron": "^0.29.1",
    "vite-plugin-electron-renderer": "^0.14.7",
    "vitest": "^4.1.11",
    "vue-tsc": "^2.0.6"
  },
  "overrides": {
    "protobufjs": "^7.6.5",
    "shell-quote": "^1.10.0",
    "hono": "^4.13.7",
    "@hono/node-server": "^2.1.0",
    "axios": "^1.18.0",
    "postcss": "^8.5.23",
    "tar": "^7.5.15",
    "minimatch": "^9.0.7",
    "@tootallnate/once": "^3.0.1"
  },
  "author": {
