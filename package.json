{
  "name": "SailFish",
  "version": "11.11.0",
  "private": true,
  "description": "旗鱼 - AI 驱动的智能助手",
  "main": "dist-electron/main.js",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "vite",
    "dev:steam": "cross-env VITE_STEAM_BUILD=true vite",
    "postinstall": "patch-package && node scripts/fix-sherpa-onnx.js",
    "ensure:oem-config": "node scripts/ensure-oem-config.js",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "build": "node scripts/download-models.js && vue-tsc --noEmit && vite build && electron-builder && node scripts/fix-mac-yml.js",
    "build:win": "node scripts/download-models.js && node scripts/download-vcredist.js && vue-tsc --noEmit && vite build && electron-builder --win --publish never",
    "build:mac": "node scripts/download-models.js && vue-tsc --noEmit && vite build && electron-builder --mac --publish never && node scripts/fix-mac-yml.js",
    "build:win:fast": "vite build && electron-builder --win",
    "build:win:remote": "node scripts/trigger-dev-win-build.js",
    "build:mac:fast": "vite build && electron-builder --mac && node scripts/fix-mac-yml.js",
    "build:dir": "vite build && electron-builder --dir",
    "install:dir": "node scripts/install-dir-build.js",
    "build:local": "npm run build:dir && node scripts/install-dir-build.js --launch",
    "typecheck": "vue-tsc --noEmit",
    "typecheck:electron": "tsc --project tsconfig.node.json --noEmit",
    "typecheck:src": "vue-tsc --noEmit --skipLibCheck",
    "check": "npm run typecheck && npm run lint:check",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:fast": "npm run typecheck:src",
    "build:check": "vue-tsc --noEmit && vite build --mode production",
    "check:asar-unpack": "node scripts/check-asar-unpack-deps.js",
    "verify": "concurrently --group --names typecheck,lint,build,unit-test,cli-test,asar-unpack -c blue,yellow,magenta,cyan,green,red \"vue-tsc --noEmit\" \"eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx\" \"vite build --mode production\" \"vitest run\" \"bash electron/cli/test-cli.sh --no-ai\" \"node scripts/check-asar-unpack-deps.js\"",
    "preview": "vite preview",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx --fix",
    "lint:check": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx",
    "format": "prettier --write src/",
    "preversion": "node scripts/preversion.js",
    "postversion": "node scripts/postversion.js",
    "generate-icons": "node scripts/generate-icons.js",
    "download:models": "node scripts/download-models.js",
    "download:vcredist": "node scripts/download-vcredist.js",
    "download:speech-model": "node scripts/download-speech-model.js",
    "download:punct-model": "node scripts/download-punct-model.js",
    "build:speech-pack": "node scripts/build-speech-pack.js",
    "download:chart-maps": "node scripts/download-chart-maps.js",
    "build:steam:win": "cross-env VITE_STEAM_BUILD=true vite build && electron-builder --win --dir --config electron-builder-steam.yml --publish never",
    "build:steam:mac": "cross-env VITE_STEAM_BUILD=true vite build && electron-builder --mac --dir --universal --config electron-builder-steam.yml --publish never",
    "build:steam:current": "cross-env VITE_STEAM_BUILD=true vite build && electron-builder --dir --config electron-builder-steam.yml --publish never",
    "sailfish": "node electron/cli/main.js",
    "cli": "node electron/cli/main.js",
    "sft": "node electron/cli/main.js",
    "install:cli": "node scripts/install-sailfish-cli-dev.js",
    "pack:firefox-extension": "bash scripts/pack-firefox-extension.sh",
    "pack:chrome-extension": "bash scripts/pack-chrome-extension.sh"
  },
  "dependencies": {
    "@firecrawl/pdf-inspector": "^1.14.1",
    "@huggingface/transformers": "^4.3.0",
    "@lancedb/lancedb": "^0.22.3",
    "@langchain/textsplitters": "^1.0.1",
    "@larksuiteoapi/node-sdk": "^1.59.0",
    "@milkdown/crepe": "^7.22.0",
    "@milkdown/kit": "^7.22.0",
    "@modelcontextprotocol/sdk": "^1.24.3",
    "@mozilla/readability": "^0.6.0",
    "@napi-rs/canvas": "^0.1.95",
    "@questi0nm4rk/shell-ast": "^0.8.0",
    "@sailfish/shared-types": "*",
    "@sailfish/workbench-assistant": "*",
    "@sailfish/workbench-companion": "*",
    "@sailfish/workbench-local": "*",
    "@sailfish/workbench-sample": "*",
    "@sailfish/workbench-sdk": "*",
    "@sailfish/workbench-ssh": "*",
    "@slack/bolt": "^4.6.0",
    "@wecom/aibot-node-sdk": "^1.0.1",
